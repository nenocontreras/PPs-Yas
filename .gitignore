# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# serwist (service worker generado en build)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — nunca commitear claves reales (ver CLAUDE.md / confidentiality-guard)
.env
.env.local
.env*.local
.env.development.local
.env.production.local
# el único .env versionado es la plantilla sin valores:
!.env.example

# Claude Code — config local del dev (no se versiona)
.claude/hooks/forbidden-terms.txt
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
