# Plantilla de variables de entorno — App de Gestión de PPS
#
# Copiá este archivo a `.env.local` y completá los valores con tus credenciales.
# `.env.local` está en .gitignore y NUNCA debe commitearse (regla no negociable
# de CLAUDE.md / confidentiality-guard).

# --- Supabase (cliente + servidor) -------------------------------------------
# Panel de Supabase → Project Settings → API
# La `anon key` es pública por diseño; el aislamiento entre usuarios lo hace RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- URL del sitio ----------------------------------------------------------
# Para los links que Supabase manda por email (confirmación de cuenta,
# recuperación de contraseña). En local podés dejarlo vacío (usa localhost:3000).
# En producción: la URL pública, ej. https://gestion-pps.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- IA para el resumen de entrevistas — SOLO servidor ----------------------
# El resumen corre sobre el texto YA transcripto y anonimizado (nunca audio).
# Configurá al menos UNA de estas keys; si ponés varias, la app rota entre ellas
# y cae a la siguiente si una falla (útil para no agotar un tier gratis).
# NUNCA con prefijo NEXT_PUBLIC_: no deben llegar al navegador.
#
# Gemini tiene tier gratis generoso → recomendado como principal.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
#
# Opcionales:
# AI_SUMMARY_PROVIDER_ORDER=gemini,openrouter,openai,anthropic  # orden estricto (desactiva la rotación)
# AI_SUMMARY_DAILY_LIMIT=15                                     # resúmenes por usuario / 24 h
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
